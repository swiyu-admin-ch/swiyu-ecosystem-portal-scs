# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-BRACES-19963945:
    - '*':
        reason: >-
          Transitive build-time-only dependency via
          @angular-devkit/build-angular > http-proxy-middleware > micromatch.
          New CVE-2026-93687 with no fixed version of braces available (registry
          mirrors only up to 3.0.3). Not shipped to production. Track upstream
          build-angular/Angular 22 upgrade (EID-6915).
        expires: 2027-02-09T09:00:00.000Z
        created: 2026-09-21T00:00:00.000Z
  SNYK-JS-FLAT-22148819:
    - '*':
        reason: >-
          No fixed flat release exists for this range: webpack-merge 6.0.1 (latest) requires
          flat ^5.0.2, and flat 6.0.1 is an ESM-only rewrite that cannot be required by
          webpack-merge. Reached only through the Angular build tooling
          (@angular-devkit/build-angular > webpack-merge), never shipped in the bundle.
          Track the upstream fix.
        expires: 2026-11-25T09:00:00.000Z
        created: 2026-11-03T09:00:00.000Z
patch: {}
