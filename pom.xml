<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-spring-boot-parent</artifactId>
        <!-- ACHTUNG: Immer wenn wir die Version updaten auch die CVE-OVERRIDES section aktualisieren -->
        <version>41.28.0</version>
        <relativePath /> <!-- lookup parent from repository -->
    </parent>

    <groupId>ch.admin.bj.swiyu</groupId>
    <artifactId>swiyu-ecosystem-portal-scs</artifactId>
    <version>2.1.7-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>Selfservice portal for the ecosystem</description>

    <modules>
        <module>swiyu-ecosystem-portal-service</module>
        <module>swiyu-ecosystem-portal-ui</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Disable javadoc by default to improve pipeline throughput -->
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- Needed by RHOS Java Build Pipeline -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- START CVE-OVERRIDES -->
            <!-- Override Jackson to >= 2.22.4 (com.fasterxml.jackson) and >= 3.2.4 (tools.jackson) to fix the
                 critical deserialization findings SNYK-JAVA-COMFASTERXMLJACKSONCORE-21761837 and
                 SNYK-JAVA-TOOLSJACKSONCORE-21761838. jEAP parent 41.28.0 manages 2.22.3 / 3.2.3 via
                 jeap-internal-spring-boot-parent 11.9.0 and Spring Boot 4.1.2 is the newest release, so no
                 upgrade path exists yet; 2.22.4 / 3.2.4 are the first releases fixing both findings. Core and
                 databind are pinned together to keep each Jackson family consistent.
                 Remove when the parent manages Jackson >= 2.22.4 / 3.2.4. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.22.4</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.22.4</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>3.2.4</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>3.2.4</version>
            </dependency>
            <!-- END CVE-OVERRIDES -->
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>bit-profile</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.rudikershaw.gitbuildhook</groupId>
                        <artifactId>git-build-hook-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <configuration>
                            <gitConfig>
                                <core.hooksPath>.git-hooks</core.hooksPath>
                            </gitConfig>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <!-- Sets git config specified under configuration > gitConfig. -->
                                    <goal>configure</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
