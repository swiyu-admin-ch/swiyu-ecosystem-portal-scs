<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-spring-boot-parent</artifactId>
        <!-- ACHTUNG: Immer wenn wir die Version updaten auch die CVE-OVERRIDES section aktualisieren -->
        <version>41.23.0</version>
        <relativePath /> <!-- lookup parent from repository -->
    </parent>

    <groupId>ch.admin.bj.swiyu</groupId>
    <artifactId>swiyu-ecosystem-portal-scs</artifactId>
    <version>2.1.4-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>Selfservice portal for the ecosystem</description>

    <modules>
        <module>swiyu-ecosystem-portal-service</module>
        <module>swiyu-ecosystem-portal-ui</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Disable javadoc by default to improve pipeline throughput -->
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- CVE-OVERRIDE start -->
        <!-- Override Tomcat to >= 11.0.27 to fix six Snyk findings on the embedded Tomcat 11.0.25
             that the parent's Spring Boot manages: -21716509 (critical, HTTP Request Smuggling,
             CVE-2026-86350), -21707477 (critical, Access Control Bypass, CVE-2026-101356),
             -21707475 (critical, Missing Critical Step in Authentication, CVE-2026-101296),
             -20552494 (critical, Authentication Bypass by Alternate Name, CVE-2026-76183),
             -21715436 (high, CVE-2026-78383) and -21246252 (high, CVE-2026-79677).
             11.0.27 is the first release fixing all six; the Snyk remediation hint (Spring Boot
             4.1.2) is not reachable, jEAP parent 41.23.0 (the latest) still manages Spring Boot
             4.1.1. The property is what the Spring Boot BOM reads for tomcat-embed-core, -el and
             -websocket, so all three move together.
             Remove when the parent manages Spring Boot with Tomcat >= 11.0.27. -->
        <tomcat.version>11.0.27</tomcat.version>
        <!-- CVE-OVERRIDE end -->
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- Needed by RHOS Java Build Pipeline -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- START CVE-OVERRIDES -->
    <!-- Currently no CVE overrides are needed. -->
    <!-- END CVE-OVERRIDES -->

    <profiles>
        <profile>
            <id>bit-profile</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.rudikershaw.gitbuildhook</groupId>
                        <artifactId>git-build-hook-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <configuration>
                            <gitConfig>
                                <core.hooksPath>.git-hooks</core.hooksPath>
                            </gitConfig>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <!-- Sets git config specified under configuration > gitConfig. -->
                                    <goal>configure</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
