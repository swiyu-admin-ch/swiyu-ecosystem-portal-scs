<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-spring-boot-parent</artifactId>
        <!-- ACHTUNG: Immer wenn wir die Version updaten auch die CVE-OVERRIDES section aktualisieren -->
        <version>41.42.0</version>
        <relativePath /> <!-- lookup parent from repository -->
    </parent>

    <groupId>ch.admin.bj.swiyu</groupId>
    <artifactId>swiyu-ecosystem-portal-scs</artifactId>
    <version>2.2.16-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>Selfservice portal for the ecosystem</description>

    <modules>
        <module>swiyu-ecosystem-portal-service</module>
        <module>swiyu-ecosystem-portal-ui</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Disable javadoc by default to improve pipeline throughput -->
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- CVE-OVERRIDES Start -->
            <!-- The jEAP parent 41.42.0 (the latest) pins every Spring Boot, Spring Framework and
                 Spring Security artifact literally, so the corresponding version properties have no
                 effect. Spring Boot 4.1.3 is the first release that fixes
                 SNYK-JAVA-ORGSPRINGFRAMEWORKBOOT-22729051 (high, insecure temporary file,
                 spring-boot-actuator) and SNYK-JAVA-ORGSPRINGFRAMEWORKBOOT-22730851 (critical, use of
                 non-canonical URL paths for authorization decisions, spring-boot-security). It ships
                 Spring Framework 7.0.11 (fixes the spring-beans, spring-core and spring-web findings) and
                 Spring Security 7.1.3 (fixes the spring-security-core, spring-security-web and
                 spring-security-oauth2-client findings); both are imported as BOMs so the whole framework
                 families stay consistent.
                 Remove when the parent manages Spring Boot >= 4.1.3. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot</artifactId>
                <version>4.1.3</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-autoconfigure</artifactId>
                <version>4.1.3</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-actuator</artifactId>
                <version>4.1.3</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-actuator-autoconfigure</artifactId>
                <version>4.1.3</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-security</artifactId>
                <version>4.1.3</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>7.0.11</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-bom</artifactId>
                <version>7.1.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- CVE-OVERRIDES End -->
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- Needed by RHOS Java Build Pipeline -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>bit-profile</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.rudikershaw.gitbuildhook</groupId>
                        <artifactId>git-build-hook-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <configuration>
                            <gitConfig>
                                <core.hooksPath>.git-hooks</core.hooksPath>
                            </gitConfig>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <!-- Sets git config specified under configuration > gitConfig. -->
                                    <goal>configure</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
